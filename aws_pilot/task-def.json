{
  "family": "<farf-prototype>-org-b",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::$AWS_ACCOUNT_ID:role/farfPilotTaskExecutionRole",
  "containerDefinitions": [{
    "name": "org-b",
    "image": "$AWS_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/<farf-prototype>-org-b:v1",
    "environment": [
      {"name": "FARF_BUS_URL", "value": "https://<farf-prototype>-bus-<GCP_PROJECT_NUMBER>.asia-south1.run.app"},
      {"name": "FARF_ORG", "value": "PilotOrgB"},
      {"name": "FARF_PEER_ORG", "value": "PilotOrgA"},
      {"name": "FARF_N_LATENCY_TRIALS", "value": "200"},
      {"name": "FARF_LOG_FORMAT", "value": "json"}
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/<farf-prototype>-org-b",
        "awslogs-region": "ap-south-1",
        "awslogs-stream-prefix": "org-b"
      }
    }
  }]
}
